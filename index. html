<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Roblox Web Peer-to-Peer</title>
    <!-- Подключаем полностью бесплатную сетевую библиотеку -->
    <script src="https://unpkg.com"></script>
    <style>
        * { box-sizing: border-box; font-family: sans-serif; margin: 0; padding: 0; user-select: none; touch-action: manipulation; }
        body { background: #1e1e24; color: #fff; display: flex; flex-direction: column; align-items: center; padding: 10px; min-height: 100vh; }
        h1 { font-size: 20px; margin-bottom: 5px; color: #f1c40f; text-shadow: 1px 1px #000; }
        .scoreboard { background: #2c3e50; padding: 10px 20px; border-radius: 10px; font-size: 16px; font-weight: bold; display: flex; gap: 20px; margin-bottom: 10px; }
        .score-item span { color: #2ecc71; }
        .game-container { display: flex; flex-direction: column; gap: 15px; width: 100%; max-width: 450px; }
        .panel { background: #2d2d35; padding: 15px; border-radius: 12px; display: flex; flex-direction: column; align-items: center; gap: 10px; }
        .btn-click { width: 90px; height: 90px; border-radius: 50%; background: radial-gradient(#e74c3c, #c0392b); color: white; font-weight: bold; border: 4px solid #fff; }
        canvas { background: #34495e; border: 3px solid #fff; border-radius: 8px; width: 100%; height: auto; aspect-ratio: 450/300; }
        .net-box { background: #111; padding: 10px; border-radius: 8px; width: 100%; font-size: 12px; margin-bottom: 10px; }
        .net-box input { width: 60%; padding: 5px; font-size: 12px; }
        .net-box button { padding: 5px 10px; background: #2ecc71; color: #fff; border: none; border-radius: 4px; }
        .mobile-controls { display: flex; justify-content: space-between; width: 100%; margin-top: 10px; }
        .move-arrows { display: flex; gap: 15px; }
        .touch-btn { width: 60px; height: 60px; background: #fff; color: #333; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: bold; box-shadow: 0 4px 0 #bdc3c7; }
        .touch-btn:active { transform: translateY(2px); box-shadow: 0 1px 0 #bdc3c7; }
        .jump-btn { background: #3498db; color: white; box-shadow: 0 4px 0 #2980b9; width: 80px; border-radius: 12px; }
    </style>
</head>
<body>

    <h1>🌐 Бесплатный Мультиплеер</h1>
    
    <!-- Сетевой блок соединения -->
    <div class="net-box">
        <div>Твой ID для друга: <b id="my-id-text" style="color:#f1c40f">Загрузка...</b></div>
        <div style="margin-top: 5px;">
            <input type="text" id="peer-id-input" placeholder="Введи ID друга">
            <button id="connect-btn">Играть вместе</button>
        </div>
    </div>

    <div class="scoreboard">
        <div class="score-item">Монеты: <span id="coins-display">0</span> 🪙</div>
        <div class="score-item">Уровень: <span id="stage-display">1</span> 🏁</div>
    </div>

    <div class="game-container">
        <div class="panel">
            <button class="btn-click" id="click-btn">КЛИК!</button>
        </div>

        <div class="panel">
            <canvas id="obbyCanvas" width="450" height="300"></canvas>
            <div class="mobile-controls">
                <div class="move-arrows">
                    <div class="touch-btn" id="btn-left">←</div>
                    <div class="touch-btn" id="btn-right">→</div>
                </div>
                <div class="touch-btn jump-btn" id="btn-jump">ПРЫЖОК</div>
            </div>
        </div>
    </div>

    <script>
        // --- СЕТЬ БЕЗ СЕРВЕРА (PeerJS) ---
        const peer = new Peer();
        let connection = null;
        let remotePlayer = { x: 0, y: 0, active: false };

        peer.on('open', (id) => {
            document.getElementById('my-id-text').innerText = id;
        });

        // Если друг подключается к нам
        peer.on('connection', (conn) => {
            connection = conn;
            setupChat();
        });

        // Если мы подключаемся к другу
        document.getElementById('connect-btn').addEventListener('click', () => {
            const peerId = document.getElementById('peer-id-input').value;
            if (peerId) {
                connection = peer.connect(peerId);
                setupChat();
            }
        });

        function setupChat() {
            connection.on('data', (data) => {
                if (data.type === 'move') {
                    remotePlayer.x = data.x;
                    remotePlayer.y = data.y;
                    remotePlayer.active = true;
                }
            });
        }

        function sendPosition() {
            if (connection && connection.open) {
                connection.send({ type: 'move', x: player.x, y: player.y });
            }
        }

        // --- ЛОГИКА ИГРЫ ---
        let gameData = { coins: 0, stage: 1 };
        const coinsDisplay = document.getElementById("coins-display");
        const stageDisplay = document.getElementById("stage-display");
        
        document.getElementById("click-btn").addEventListener("click", () => { gameData.coins += 10; coinsDisplay.innerText = gameData.coins; });

        // --- ФИЗИКА КАНВАСА ---
        const canvas = document.getElementById("obbyCanvas"); const ctx = canvas.getContext("2d");
        let player = { x: 30, y: 200, width: 20, height: 20, speedX: 0, speedY: 0, jumping: false, color: '#3498db' };
        let gravity = 0.4; let friction = 0.8;
        let platforms = [{ x: 0, y: 280, width: 90, height: 20 }, { x: 140, y: 210, width: 70, height: 15 }, { x: 280, y: 150, width: 70, height: 15 }, { x: 380, y: 110, width: 70, height: 20 }];
        let lavaBricks = [{ x: 90, y: 295, width: 290, height: 5 }];
        let finishFlag = { x: 400, y: 60, width: 30, height: 50 };

        let controls = { left: false, right: false, jump: false };

        const setupTouch = (btnId, controlKey) => {
            const btn = document.getElementById(btnId);
            btn.addEventListener("touchstart", (e) => { e.preventDefault(); controls[controlKey] = true; });
            btn.addEventListener("touchend", () => controls[controlKey] = false);
        };
        setupTouch("btn-left", "left"); setupTouch("btn-right", "right"); setupTouch("btn-jump", "jump");

        function updatePhysics() {
            if (controls.right) { if (player.speedX < 4) player.speedX++; }
            if (controls.left) { if (player.speedX > -4) player.speedX--; }
            if (controls.jump && !player.jumping) { player.speedY = -8; player.jumping = true; }

            player.speedX *= friction; player.speedY += gravity;
            player.x += player.speedX; player.y += player.speedY;

            if (player.x < 0) player.x = 0; if (player.x > canvas.width - player.width) player.x = canvas.width - player.width;

            let onGround = false;
            for (let plat of platforms) {
                if (player.x < plat.x + plat.width && player.x + player.width > plat.x && player.y + player.height <= plat.y + 10 && player.y + player.height + player.speedY >= plat.y) {
                    player.jumping = false; player.speedY = 0; player.y = plat.y - player.height; onGround = true;
                }
            }
            if (!onGround && player.y < 280) player.jumping = true;

            for (let lava of lavaBricks) {
                if (player.x < lava.x + lava.width && player.x + player.width > lava.x && player.y < lava.y + lava.height && player.y + player.height > lava.y) resetPlayer();
            }

            if (player.x < finishFlag.x + finishFlag.width && player.x + player.width > finishFlag.x && player.y < finishFlag.y + finishFlag.height && player.y + player.height > finishFlag.y) {
                gameData.stage++; gameData.coins += 100; coinsDisplay.innerText = gameData.coins; stageDisplay.innerText = gameData.stage; resetPlayer();
            }
            if (player.y > canvas.height) resetPlayer();

            sendPosition();
        }

        function resetPlayer() { player.x = 30; player.y = 200; player.speedX = 0; player.speedY = 0; }

        function draw() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = "#7f8c8d"; for (let plat of platforms) ctx.fillRect(plat.x, plat.y, plat.width, plat.height);
            ctx.fillStyle = "#e74c3c"; for (let lava of lavaBricks) ctx.fillRect(lava.x, lava.y, lava.width, lava.height);
            ctx.fillStyle = "#2ecc71"; ctx.fillRect(finishFlag.x, finishFlag.y, finishFlag.width, finishFlag.height);

            // Отрисовка друга
            if (remotePlayer.active) {
                ctx.fillStyle = "#e67e22";
                ctx.fillRect(remotePlayer.x, remotePlayer.y, 20, 20);
            }

            // Отрисовка себя
            ctx.fillStyle = player.color; ctx.fillRect(player.x, player.y, player.width, player.height);
        }

        function gameLoop() { updatePhysics(); draw(); requestAnimationFrame(gameLoop); }
        gameLoop();
    </script>
</body>
</html>
